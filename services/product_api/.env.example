APP_ENV=dev
LOG_LEVEL=INFO
# Optional in local/default-off use. Production rollout mutation accepts only
# an exact lowercase 40-hex commit equal to the approved decision.
# PRODUCT_RELEASE_COMMIT=
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
GATEWAY_URL=http://gateway_api:8001
GATEWAY_SHARED_SECRET=dev-shared-secret
SUPERADMIN_EMAIL=you@example.com
AUTH_TOKEN_SECRET=change-me
AUTH_TOKEN_TTL_SECONDS=900
CLAIM_EDIT_TOKEN_SECRET=change-me-claims
CLAIMS_PRICE_RUB=990
CLAIMS_UPLOAD_DIR=/var/lib/product_api/claims_uploads
CLAIMS_UPLOAD_ROOT=./.runtime/claims_uploads
CLAIMS_MAX_FILE_SIZE_BYTES=10485760
CLAIMS_ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain
CLAIMS_ADMIN_EMAILS=claims-admin@example.com
INVITE_TOKEN_SECRET=change-me
SESSION_SECRET=change-me-too
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:8000
INVITE_TTL_SECONDS=604800
CHAT_CONTEXT_LIMIT=20
GATEWAY_TIMEOUT_SECONDS=30
CLAIMS_FIO_AI_ENABLED=false
CLAIMS_FIO_AI_MODEL=gpt-5.2
CLAIMS_FIO_AI_PROMPT_VERSION=v1
CLAIMS_FIO_AI_TIMEOUT_SECONDS=10
CLAIMS_FIO_AI_CACHE_TTL_SECONDS=86400
CLAIMS_FIO_AI_NEGATIVE_CACHE_TTL_SECONDS=300
AI_EXPLANATION_ENABLED=false
AI_EXPLANATION_MODEL_PROFILE=economy_text_structured_v1
AI_EXPLANATION_PROMPT_VERSION=v1
AI_EXPLANATION_MAX_INPUT_TOKENS=4096
AI_EXPLANATION_MAX_OUTPUT_TOKENS=600
AI_EXPLANATION_TIMEOUT_SECONDS=20
DATANEWTON_ENABLED=false
DATANEWTON_BASE_URL=https://api.datanewton.ru
DATANEWTON_API_KEY=
DATANEWTON_TIMEOUT_SECONDS=10
DATANEWTON_RETRY_COUNT=1
DATANEWTON_COUNTERPARTY_FILTERS=MANAGER_BLOCK,ADDRESS_BLOCK
DATANEWTON_CACHE_TTL_SECONDS=300
COMPANY_REPORT_WORKER_POLL_INTERVAL_SECONDS=1
COMPANY_REPORT_WORKER_LEASE_SECONDS=60
COMPANY_REPORT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
COMPANY_REPORT_WORKER_SHUTDOWN_GRACE_SECONDS=30
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_COMPANY_RPM=60
RATE_LIMIT_USER_RPM=30
RATE_LIMIT_IP_RPM=120
SEO_PUBLIC_ROLLOUT_ENABLED=false
SEO_PUBLIC_BASE_URL=http://localhost:8000
SEO_PUBLISH_BATCH_MAX_LIMIT=25
SEO_SITEMAP_CHUNK_SIZE=1000
COMPANY_CARD_V2_PRESENTATIONS_ENABLED=false
COMPANY_CARD_V2_WRITER_ENABLED=false
COMPANY_CARD_V2_ROLLOUT_GENERATION=0
COMPANY_CARD_V2_ALLOWLIST_INNS=
COMPANY_CARD_V2_PERCENTAGE_BASIS_POINTS=0
COMPANY_CARD_V2_ARBITRATION_COLLECTION_ENABLED=false
# P8 key ID/keyring stay truly unset. Do not add empty assignments: activation
# requires a separate reviewed immutable key binding and deletion/tombstone plan.
# COMPANY_CARD_V2_ARBITRATION_MASK_ACTIVE_KEY_ID=UNSET/STOP
# COMPANY_CARD_V2_ARBITRATION_MASK_KEYRING_JSON=UNSET/STOP
COMPANY_CARD_AI_NARRATIVE_ENABLED=false
COMPANY_CARD_AI_NARRATIVE_KILL_SWITCH=true
COMPANY_CARD_AI_NARRATIVE_DAILY_DISPATCH_CREDITS=0
COMPANY_CARD_AI_NARRATIVE_MONTHLY_DISPATCH_CREDITS=0
COMPANY_CARD_AI_NARRATIVE_WORKER_CONCURRENCY=0
COMPANY_CARD_AI_NARRATIVE_GATEWAY_TIMEOUT_SECONDS=20
COMPANY_CARD_AI_NARRATIVE_MAX_OUTPUT_TOKENS=600
