APP_ENV=dev
LOG_LEVEL=INFO
GATEWAY_SHARED_SECRET=dev-shared-secret
# Optional locally; production deploy injects the exact release SHA.
# GATEWAY_RELEASE_COMMIT=
OPENAI_API_KEY=replace-me
OPENAI_TIMEOUT_SECONDS=30
AI_EXPLANATION_MODEL_PROFILE=economy_text_structured_v1
AI_EXPLANATION_MODEL=gpt-5.2
GATEWAY_CLOCK_SKEW_SECONDS=60
GATEWAY_NONCE_TTL_SECONDS=300
COMPANY_CARD_NARRATIVE_GATEWAY_ENABLED=false
COMPANY_CARD_NARRATIVE_MODEL_PROFILE=company_card_narrative_structured_v1
COMPANY_CARD_NARRATIVE_MODEL=gpt-5-nano
